<!-- ======================================================
  Simplified 3-DOF Jaco Arm (J1, J2, J3 only)
====================================================== -->

<mujoco model="jaco_3dof">
  <compiler inertiafromgeom='true' angle="radian" meshdir="meshes/" />

  <option integrator="implicitfast" solver="Newton" timestep="0.002" gravity="0 0 0" iterations="100"/>

  <visual>
    <global offwidth="1920" offheight="1080" elevation="-30" azimuth="120"/>
    <quality shadowsize="4096" offsamples="16"/>
    <headlight ambient=".4 .4 .4" diffuse=".8 .8 .8" specular="0.1 0.1 0.1"/>
    <map fogstart="3" fogend="10"/>
  </visual>

  <asset>
    <mesh file="jaco_link_base.stl"/>
    <mesh file="jaco_link_1.stl"/>
    <mesh file="jaco_link_2.stl"/>
    <mesh file="jaco_link_3.stl"/>
    <mesh file="jaco_link_4.stl"/>
    <mesh file="jaco_link_5.stl"/>
    <mesh file="jaco_link_hand.stl"/>
    <mesh file="jaco_link_finger_1.stl"/>
    <mesh file="jaco_link_finger_2.stl"/>
    <mesh file="jaco_link_finger_3.stl"/>

    <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="1 1 1" width="2048" height="2048"/>
    <texture name="groundplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .2 .3" width="2048" height="2048" mark="edge" markrgb=".8 .8 .8"/>
    <material name="MatViz" specular="1" shininess=".3" reflectance="0.5" rgba=".1 .1 .1 1"/>
    <material name="MatGnd" texture="groundplane" texrepeat="5 5" specular="1" shininess=".3" reflectance="0.2"/>
  </asset>

  <default>
    <geom contype='1' conaffinity='1' condim='3' margin="0.001" />
    <joint limited="true" damping="5.0" armature=".1"/>
    <default class ="vizNcoll">
      <geom material="MatViz" type="mesh" condim="3" contype="1" conaffinity="1" margin="0.001"/>
      <joint pos="0 0 0" type="hinge" range="-3.141 3.141"/>
    </default>
    <default class ="ground">
      <geom type="plane" margin="0.001" contype="1" />
    </default>
  </default>

  <worldbody>
    <light directional="true" diffuse=".8 .8 .8" specular=".2 .2 .2" pos="0 0 5" dir="0 0 -1"/>
    <light directional="false" diffuse=".4 .4 .4" specular="0.1 0.1 0.1" pos="0 0 5" castshadow="false"/>
    
    <camera name="view1" pos="0 0 2.0" zaxis="0 0 1" fovy="45" ipd="0.068"/>
    <camera name="view2" pos="1.0 0.7 0.3" xyaxes="-1 1 0 0 0 1" fovy="45" ipd="0.068"/>

    <geom name="ground" class="ground" type='plane' pos="0 0 0" material="MatGnd" size="5 5 1"/>

    <body name="jaco_link_base" childclass="vizNcoll" pos="0 0 0.25">
      <geom mesh="jaco_link_base"/>
      <geom type="capsule" pos="0 0 -0.125" size=".045 0.125"/>

      <!-- Arm Joint 1: Base Rotation -->
      <body name="jaco_link_1" childclass="vizNcoll" pos="0 0 0.1535" quat="0 0 1 0">
        <joint name="jaco_joint_1" axis="0 0 -1" limited="true" range="-3.141 3.141" />
        <geom mesh="jaco_link_1"/>

        <!-- Arm Joint 2: Shoulder Pitch -->
        <body name="jaco_link_2" pos="0 0 -0.1185" quat="0 0 0.707107 0.707107">
          <joint name="jaco_joint_2" axis="0 0 1" limited="true" range="-2.409 2.409"/>
          <geom mesh="jaco_link_2"/>

          <!-- Arm Joint 3: Elbow Pitch -->
          <body name="jaco_link_3" pos="0.41 0 0" quat="0 0.707107 0.707107 0">
            <joint name="jaco_joint_3" axis="0 0 -1" limited="true" range="-2.845 2.845"/>
            <geom mesh="jaco_link_3"/>

            <!-- FIXED: Joint 4 removed -->
            <body name="jaco_link_4" pos="0.207 0 -0.01125" quat="0 0.707107 0 -0.707107">
              <geom mesh="jaco_link_4"/>

              <!-- FIXED: Joint 5 removed -->
              <body name="jaco_link_5" pos="0.0343 0 -0.06588" quat="0.887011 0 -0.461749 0">
                <geom mesh="jaco_link_5"/>

                <!-- FIXED: Joint 6 removed -->
                <body name="jaco_link_hand" pos="0.0343 0 -0.06588" quat="0.627211 -0.326506 -0.326506 0.627211">
                  <geom mesh="jaco_link_hand" rgba=".13 .13 .13 1"/>

                  <!-- FIXED: Finger Joints removed -->
                  <body name="jaco_link_finger_1" pos="-0.03978 0 -0.10071" quat="-0.414818 -0.329751 -0.663854 0.52772">
                    <geom mesh="jaco_link_finger_1"/>
                  </body>
                  <body name="jaco_link_finger_2" pos="0.03569 -0.0216 -0.10071" quat="0.625248 -0.567602 0.434845 0.312735">
                    <geom mesh="jaco_link_finger_2"/>
                  </body>
                  <body name="jaco_link_finger_3" pos="0.03569 0.0216 -0.10071" quat="0.561254 -0.620653 0.321748 0.443014">
                    <geom mesh="jaco_link_finger_3"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
    <!-- Obstacle for C-Space -->
    <body name="obstacle" pos="0.4 0.2 0.05">
      <geom name="box_obs" type="box" size="0.1 0.1 0.05" rgba="0.8 0.2 0.2 1" contype="1" conaffinity="1"/>
    </body>
  </worldbody>

  <actuator>
    <position joint='jaco_joint_1' name='pos_j1' kp="500" kv="50" ctrlrange='-3.141 3.141' ctrllimited="true"/>
    <position joint='jaco_joint_2' name='pos_j2' kp="500" kv="50" ctrlrange='-2.409 2.409' ctrllimited="true"/>
    <position joint='jaco_joint_3' name='pos_j3' kp="500" kv="50" ctrlrange='-2.845 2.845' ctrllimited="true"/>
  </actuator>
</mujoco>
