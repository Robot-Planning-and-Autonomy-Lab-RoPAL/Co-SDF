<mujoco model="fr3 scene">
  <compiler meshdir="../assets"/>
  <include file="../models/fr3.xml"/>

  <statistic center="0.2 0 0.4" extent=".8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Open-style 3-layer bookshelf (1m wide) -->
    <body name="bookshelf" pos="0.8 0 0" euler="0 0 3.14159">
      <!-- Support poles at 4 corners -->
      <geom name="bs_pole_bl" type="cylinder" size="0.02 0.6" pos="0.2 0.5 0.6" rgba="0.3 0.25 0.2 1"/>
      <geom name="bs_pole_br" type="cylinder" size="0.02 0.6" pos="0.2 -0.5 0.6" rgba="0.3 0.25 0.2 1"/>
      <geom name="bs_pole_fl" type="cylinder" size="0.02 0.6" pos="-0.2 0.5 0.6" rgba="0.3 0.25 0.2 1"/>
      <geom name="bs_pole_fr" type="cylinder" size="0.02 0.6" pos="-0.2 -0.5 0.6" rgba="0.3 0.25 0.2 1"/>
      
      <!-- Bottom shelf (on ground) -->
      <geom name="bs_shelf0" type="box" size="0.2 0.5 0.015" pos="0 0 0.015" rgba="0.45 0.35 0.25 1"/>
      <!-- Shelf 1 -->
      <geom name="bs_shelf1" type="box" size="0.2 0.5 0.015" pos="0 0 0.4" rgba="0.45 0.35 0.25 1"/>
      <!-- Shelf 2 -->
      <geom name="bs_shelf2" type="box" size="0.2 0.5 0.015" pos="0 0 0.8" rgba="0.45 0.35 0.25 1"/>
      <!-- Shelf 3 (top) -->
      <geom name="bs_shelf3" type="box" size="0.2 0.5 0.015" pos="0 0 1.2" rgba="0.45 0.35 0.25 1"/>
    </body>
  </worldbody>
</mujoco>
