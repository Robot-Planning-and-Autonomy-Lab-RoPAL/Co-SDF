    <geom name="table_leg2" type="cylinder" size="0.04 0.38" pos="0.85 -0.75 -0.42" rgba="0.4 0.3 0.2 1"/>
    <geom name="table_leg3" type="cylinder" size="0.04 0.38" pos="-0.25 0.75 -0.42" rgba="0.4 0.3 0.2 1"/>
    <geom name="table_leg4" type="cylinder" size="0.04 0.38" pos="0.85 0.75 -0.42" rgba="0.4 0.3 0.2 1"/>

