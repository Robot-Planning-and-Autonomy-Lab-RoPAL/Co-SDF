<mujoco model="fr3_table_scene">
  <compiler meshdir="../assets"/>
  <include file="../models/fr3.xml"/>

  <statistic center="0.2 0 0.4" extent=".8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.5 0.4 0.3 1" reflectance="0.1"/>
    <material name="obstacle_mat" rgba="0.9 0.1 0.1 1" reflectance="0.5"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" pos="0 0 -0.8" material="groundplane"/>

    <!-- Large Table for robot and obstacles (robot at 0,0,0) -->
    <geom name="table_surface" type="box" size="0.6 0.8 0.02" pos="0.3 0 -0.02" material="table_mat"/>
    
    <!-- Legs for visuals -->
    <geom name="table_leg1" type="cylinder" size="0.04 0.38" pos="-0.25 -0.75 -0.42" rgba="0.4 0.3 0.2 1"/>
    <geom name="table_leg2" type="cylinder" size="0.04 0.38" pos="0.85 -0.75 -0.42" rgba="0.4 0.3 0.2 1"/>
    <geom name="table_leg3" type="cylinder" size="0.04 0.38" pos="-0.25 0.75 -0.42" rgba="0.4 0.3 0.2 1"/>
    <geom name="table_leg4" type="cylinder" size="0.04 0.38" pos="0.85 0.75 -0.42" rgba="0.4 0.3 0.2 1"/>
    <geom name="obs_0" type="box" size="0.079 0.079 0.079" pos="0.290 -0.074 0.079" rgba="0.45 0.70 0.76 1.00"/>
    <geom name="obs_1" type="box" size="0.071 0.071 0.071" pos="0.633 -0.112 0.071" rgba="0.22 0.27 0.41 1.00"/>
    <geom name="obs_2" type="cylinder" size="0.082 0.082" pos="0.800 -0.148 0.082" rgba="0.84 0.39 0.39 1.00"/>
    <geom name="obs_3" type="box" size="0.085 0.085 0.085" pos="0.407 0.227 0.085" rgba="0.80 0.69 0.59 1.00"/>
    <geom name="obs_4" type="box" size="0.067 0.067 0.067" pos="0.800 0.039 0.067" rgba="0.58 0.41 0.21 1.00"/>
    <geom name="obs_5" type="box" size="0.066 0.066 0.066" pos="0.685 0.334 0.066" rgba="0.45 0.70 0.76 1.00"/>
    <geom name="obs_6" type="sphere" size="0.065" pos="0.298 -0.279 0.065" rgba="0.22 0.27 0.41 1.00"/>
    <geom name="obs_7" type="box" size="0.065 0.065 0.065" pos="0.430 0.435 0.065" rgba="0.84 0.39 0.39 1.00"/>
    <geom name="obs_8" type="box" size="0.072 0.072 0.072" pos="0.200 0.137 0.072" rgba="0.80 0.69 0.59 1.00"/>
    <geom name="obs_9" type="cylinder" size="0.073 0.073" pos="0.460 -0.050 0.073" rgba="0.58 0.41 0.21 1.00"/>
